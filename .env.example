# Environment Variables for Advent of Agents - Day 20
# Copy to .env and customize with your live Apigee host & project

# Target Apigee host or IP
APIGEE_HOST=api.enterprise.example.com

# Target Apigee MCP endpoint
APIGEE_MCP_URL=https://api.enterprise.example.com/v1/mcp

# Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Apigee Environment Name (e.g. dev, eval, pre-prod, prod)
ENV_NAME=eval

# Optional: Agent Gateway Egress endpoint
AGENT_GATEWAY_ENDPOINT=http://agent-egress-gateway.internal:8080
