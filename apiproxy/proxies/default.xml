<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Enterprise MCP Proxy Endpoint with Built-In Context Optimization</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>Spike-Arrest</Name></Step>
            <Step><Name>Extract-MCP-Method</Name></Step>
        </Request>
    </PreFlow>
    <Flows>
        <Flow name="MCP-Tools-List-Scoped-Procore">
            <Description>Return filtered Procore tools when X-Agent-Scope is procore</Description>
            <Request/>
            <Response>
                <Step><Name>Assign-Tools-List-Procore</Name></Step>
            </Response>
            <Condition>(request.verb = "POST") and (mcp_method = "tools/list") and (request.header.X-Agent-Scope = "procore")</Condition>
        </Flow>
        <Flow name="MCP-Tools-List-Unfiltered">
            <Description>Return all tools when no scope is passed (demonstrating context bloat)</Description>
            <Request/>
            <Response>
                <Step><Name>Assign-Tools-List-All</Name></Step>
            </Response>
            <Condition>(request.verb = "POST") and (mcp_method = "tools/list")</Condition>
        </Flow>
        <Flow name="MCP-Tools-Call">
            <Description>Execute MCP tool calls</Description>
            <Request/>
            <Response>
                <Step><Name>Assign-Tools-Call-RFI</Name></Step>
            </Response>
            <Condition>(request.verb = "POST") and (mcp_method = "tools/call")</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow"/>
    <HTTPProxyConnection>
        <BasePath>/v1/mcp</BasePath>
        <VirtualHost>default</VirtualHost>
    </HTTPProxyConnection>
    <!-- Built-in Mock Routing: No external backend dependency required! -->
    <RouteRule name="noroute"/>
</ProxyEndpoint>
