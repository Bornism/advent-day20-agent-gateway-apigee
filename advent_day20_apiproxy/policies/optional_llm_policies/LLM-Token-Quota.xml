<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Optional Policy: Apigee LLMTokenQuota
  Enforces token-based rate limiting on LLM responses and agent tool executions.
  Tracks total token consumption per agent identity to protect downstream GenAI quotas.
-->
<LLMTokenQuota continueOnError="false" enabled="true" name="LLM-Token-Quota" type="calendar">
    <Identifier ref="request.header.X-Agent-Identity"/>
    <Interval>1</Interval>
    <TimeUnit>minute</TimeUnit>
    <Allow count="100000"/>
    <LLMTokenUsageSource>{jsonPath('$.usageMetadata.totalTokenCount',response.content,true)}</LLMTokenUsageSource>
    <LLMModelSource>{jsonPath('$.model',response.content,true)}</LLMModelSource>
    <Distributed>true</Distributed>
    <Synchronous>true</Synchronous>
</LLMTokenQuota>
