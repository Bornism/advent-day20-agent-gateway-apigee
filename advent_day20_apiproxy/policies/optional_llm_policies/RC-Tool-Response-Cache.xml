<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Optional Policy: MCP Tool Response Cache
  Caches idempotent tool queries (such as product specs, pricing tiers, FAQs)
  at the Apigee edge. Saves LLM inference latency and avoids redundant backend hits.
-->
<ResponseCache continueOnError="false" enabled="true" name="RC-Tool-Response-Cache">
    <CacheKey>
        <Prefix>mcp_tool_cache</Prefix>
        <KeyFragment ref="request.header.X-Agent-Identity"/>
        <KeyFragment ref="mcp.tool_name"/>
        <KeyFragment ref="request.content"/>
    </CacheKey>
    <Scope>Exclusive</Scope>
    <ExpirySettings>
        <TimeoutInSeconds>300</TimeoutInSeconds>
    </ExpirySettings>
    <SkipCacheLookup>request.verb != "POST" or mcp.method != "tools/call"</SkipCacheLookup>
    <SkipCachePopulation>response.status.code != 200</SkipCachePopulation>
</ResponseCache>
