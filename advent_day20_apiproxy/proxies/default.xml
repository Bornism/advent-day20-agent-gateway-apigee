<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>SA-SpikeArrest</Name>
            </Step>
            <Step>
                <Name>Extract-MCP-Method</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="ToolsList">
            <Description>Handle tools/list discovery</Description>
            <Request/>
            <Response>
                <Step>
                    <Name>AM-Return-Tools-List</Name>
                </Step>
            </Response>
            <Condition>(request.verb = "POST") and (mcp_method = "tools/list")</Condition>
        </Flow>
        <Flow name="ToolsCall">
            <Description>Handle tools/call execution</Description>
            <Request/>
            <Response>
                <Step>
                    <Name>AM-Execute-Customer-Lookup</Name>
                </Step>
            </Response>
            <Condition>(request.verb = "POST") and (mcp_method = "tools/call")</Condition>
        </Flow>
    </Flows>
    <HTTPProxyConnection>
        <BasePath>/v1/mcp</BasePath>
        <Properties/>
        <VirtualHost>default</VirtualHost>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="noroute"/>
</ProxyEndpoint>
